@model Producto
@{ ViewData["Title"] = "Editar producto"; }
<h1>Editar producto #@Model.Id</h1>
<form asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label asp-for="Nombre"></label>
    <input asp-for="Nombre" />
    <span asp-validation-for="Nombre" class="error"></span>
    <label asp-for="Precio"></label>
    <input asp-for="Precio" type="number" step="0.01" />
    <span asp-validation-for="Precio" class="error"></span>
    <button type="submit">Guardar cambios</button>
</form>
<p><a asp-action="Detalle" asp-route-id="@Model.Id">Cancelar</a></p>
