@model List<Producto>
@{ ViewData["Title"] = "Productos"; }
<h1>Productos</h1>
<p><a asp-action="Crear">Crear producto</a></p>
<table>
    <thead><tr><th>ID</th><th>Nombre</th><th>Precio (₡)</th><th>Acciones</th></tr></thead>
    <tbody>
    @foreach (var producto in Model)
    {
        <tr>
            <td>@producto.Id</td><td>@producto.Nombre</td><td>@producto.Precio.ToString("N2")</td>
            <td><a asp-action="Detalle" asp-route-id="@producto.Id">Ver detalle</a></td>
        </tr>
    }
    </tbody>
</table>
