@model int
@* Vista parcial compartida entre el catálogo y el detalle. *@
@if (Model == 0)
{
    <span class="estado agotado">Sin existencias</span>
}
else if (Model < 5)
{
    <span class="estado pocas">Últimas unidades: @Model</span>
}
else
{
    <span class="estado disponible">Disponible: @Model unidades</span>
}



