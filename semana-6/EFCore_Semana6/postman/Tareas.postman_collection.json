{
  "info": {
    "_postman_id": "e3e6dd18-eec4-48e4-9d07-98107286a7dd",
    "name": "EFCore Semana 6 - API completa",
    "description": "Colección para todas las rutas de la API: tareas, categorías, usuarios y reasignaciones. Inicie la API y actualice las variables de IDs para que coincidan con registros existentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "tareaId",
      "value": "1"
    },
    {
      "key": "categoriaId",
      "value": "1"
    },
    {
      "key": "responsableId",
      "value": "1"
    },
    {
      "key": "usuarioId",
      "value": "1"
    },
    {
      "key": "usuarioOrigenId",
      "value": "1"
    },
    {
      "key": "usuarioDestinoId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Inicio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "description": "Redirige a /api/tareas."
      }
    },
    {
      "name": "Tareas",
      "item": [
        {
          "name": "Listar tareas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tareas"
          }
        },
        {
          "name": "Obtener tarea por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tareas/{{tareaId}}"
          }
        },
        {
          "name": "Listar tareas con categoria y responsable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tareas/detalle"
          }
        },
        {
          "name": "Resumen de tareas por categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tareas/resumen-por-categoria"
          }
        },
        {
          "name": "Crear tarea",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Preparar la clase de EF Core\",\n  \"descripcion\": \"Repasar DbContext, migraciones y PostgreSQL\",\n  \"completada\": false,\n  \"prioridad\": \"Alta\",\n  \"categoriaId\": {{categoriaId}},\n  \"responsableId\": {{responsableId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tareas"
          }
        },
        {
          "name": "Actualizar tarea",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Preparar la clase de EF Core\",\n  \"descripcion\": \"Ejemplos revisados\",\n  \"completada\": true,\n  \"prioridad\": \"Media\",\n  \"categoriaId\": {{categoriaId}},\n  \"responsableId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tareas/{{tareaId}}"
          }
        },
        {
          "name": "Listar tareas por estado (funcion PostgreSQL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tareas/por-estado?completada=false"
          }
        },
        {
          "name": "Eliminar tarea",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tareas/{{tareaId}}"
          }
        }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        {
          "name": "Crear categoría",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Universidad\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/categorias"
          }
        },
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categorias"
          }
        },
        {
          "name": "Actualizar categoría",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Universidad actualizada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/categorias/{{categoriaId}}"
          }
        },
        {
          "name": "Eliminar categoría",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/categorias/{{categoriaId}}",
            "description": "Devuelve 409 si todavía hay tareas asociadas."
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Rodríguez\",\n  \"email\": \"ana@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Rodríguez actualizada\",\n  \"email\": \"ana.actualizada@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}",
            "description": "Las tareas asignadas al usuario quedan sin responsable."
          }
        }
      ]
    },
    {
      "name": "Reasignación",
      "item": [
        {
          "name": "Reasignar tareas con transacción EF Core",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioOrigenId\": {{usuarioOrigenId}},\n  \"usuarioDestinoId\": {{usuarioDestinoId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tareas/reasignar-con-transaccion"
          }
        },
        {
          "name": "Reasignar tareas con procedimiento PostgreSQL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioOrigenId\": {{usuarioOrigenId}},\n  \"usuarioDestinoId\": {{usuarioDestinoId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tareas/reasignar-con-procedimiento"
          }
        }
      ]
    }
  ]
}
